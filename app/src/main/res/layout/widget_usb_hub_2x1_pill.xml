<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/widget_hub_root"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_gravity="center_vertical"
        android:background="@drawable/bg_widget_card_active"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="4dp">

        <LinearLayout
            android:id="@+id/btn_hub_usb"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_btn_on"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/icon_hub_usb"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_qs_usb_debug"
                android:tint="#0B1F14" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_hub_wireless"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_btn_off"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/icon_hub_wireless"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_qs_wireless_debug" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
