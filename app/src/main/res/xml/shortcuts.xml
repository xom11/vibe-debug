<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_usb"
        android:shortcutDisabledMessage="@string/app_name"
        android:shortcutId="usb_debug"
        android:shortcutLongLabel="@string/shortcut_usb_long"
        android:shortcutShortLabel="@string/shortcut_usb_short">
        <intent
            android:action="io.github.xom11.vibedebug.SHORTCUT_USB_DEBUG"
            android:targetClass="io.github.xom11.vibedebug.shortcut.ShortcutDispatchActivity"
            android:targetPackage="io.github.xom11.vibedebug" />
    </shortcut>

    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_wireless"
        android:shortcutDisabledMessage="@string/app_name"
        android:shortcutId="wireless_debug"
        android:shortcutLongLabel="@string/shortcut_wireless_long"
        android:shortcutShortLabel="@string/shortcut_wireless_short">
        <intent
            android:action="io.github.xom11.vibedebug.SHORTCUT_WIRELESS_DEBUG"
            android:targetClass="io.github.xom11.vibedebug.shortcut.ShortcutDispatchActivity"
            android:targetPackage="io.github.xom11.vibedebug" />
    </shortcut>

    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_shield"
        android:shortcutDisabledMessage="@string/app_name"
        android:shortcutId="dev_options_top"
        android:shortcutLongLabel="@string/shortcut_dev_off_long"
        android:shortcutShortLabel="@string/shortcut_dev_off_short">
        <intent
            android:action="io.github.xom11.vibedebug.SHORTCUT_DEV_TOP"
            android:targetClass="io.github.xom11.vibedebug.shortcut.ShortcutDispatchActivity"
            android:targetPackage="io.github.xom11.vibedebug" />
    </shortcut>
</shortcuts>
